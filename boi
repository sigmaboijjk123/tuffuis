function draggify(element) {
    // Mouse event handling
    element.addEventListener('mousedown', function (event) {
        element.style.cursor = 'grabbing';
        let offsetX = event.clientX - element.getBoundingClientRect().left;
        let offsetY = event.clientY - element.getBoundingClientRect().top;

        function mouseMoveHandler(event) {
            element.style.left = `${event.clientX - offsetX}px`;
            element.style.top = `${event.clientY - offsetY}px`;
        }

        function mouseUpHandler() {
            document.removeEventListener('mousemove', mouseMoveHandler);
            document.removeEventListener('mouseup', mouseUpHandler);
            element.style.cursor = 'grab';
        }

        document.addEventListener('mousemove', mouseMoveHandler);
        document.addEventListener('mouseup', mouseUpHandler);
    });

    // Touch event handling
    element.addEventListener('touchstart', function (event) {
        element.style.cursor = 'grabbing';
        let touch = event.touches[0];
        let offsetX = touch.clientX - element.getBoundingClientRect().left;
        let offsetY = touch.clientY - element.getBoundingClientRect().top;

        function touchMoveHandler(event) {
            let touch = event.touches[0];
            element.style.left = `${touch.clientX - offsetX}px`;
            element.style.top = `${touch.clientY - offsetY}px`;
        }

        function touchEndHandler() {
            document.removeEventListener('touchmove', touchMoveHandler);
            document.removeEventListener('touchend', touchEndHandler);
            element.style.cursor = 'grab';
        }

        document.addEventListener('touchmove', touchMoveHandler);
        document.addEventListener('touchend', touchEndHandler);
    });
}